#include <winuser.h>
1 ICON "../../installer/fable3restored.ico"
1 24 "launcher.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Fable III Restored launcher"
      VALUE "ProductName", "Fable III Restored"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "FableLauncher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
